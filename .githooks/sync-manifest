#!/usr/bin/env bash
# Keep this repository's untracked Julia Manifest legal after git moves a
# Project.toml.
#
# The repository is one Pkg workspace with ONE Manifest, at its root
# (regenerable from the Project.toml files plus the registries, so untracked).
# A pull, checkout or rebase that changes a Project.toml anywhere (a package,
# its test/ or docs/ env, ci/) can leave it illegal; this hook re-resolves it
# once, at the root. Precompilation is deferred to the first `using`.
#
# It is the Visual Geometry Toolkit's hook (VisualGeometryToolkitCore/githooks/
# sync-manifest) with one difference: that one reports which direct
# dependencies moved through VisualGeometryToolkitCore's `sync_manifest`, read
# by path from the monorepo's own checkout. Here VisualGeometryToolkitCore is
# an installed dependency, which must not be loaded while the Manifest may be
# illegal, so this hook calls Pkg (a standard library) directly.
#
# Installed as post-merge, post-checkout and post-rewrite (links to this file),
# once per clone:  git config core.hooksPath .githooks
#
# Never fails the git command; on error it says what to run by hand.
# Manual form:  .githooks/sync-manifest [<old-rev> [<new-rev>]]

set -u
set -o pipefail
repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo" || exit 0
hook=$(basename "$0")

case "$hook" in
  post-merge)    old=ORIG_HEAD; new=HEAD ;;
  post-rewrite)  [ "${1:-}" = rebase ] || exit 0; old=ORIG_HEAD; new=HEAD ;;
  post-checkout) [ "${3:-0}" = 1 ] || exit 0; old=$1; new=$2 ;;
  *)             old=${1:-ORIG_HEAD}; new=${2:-HEAD} ;;
esac

log() { printf '[sync-manifest] %s\n' "$*" >&2; }

# Nothing to do unless a Project.toml moved (deps, compat and version live there).
if git rev-parse --verify -q "$old^{commit}" >/dev/null 2>&1; then
  git diff --quiet "$old" "$new" -- ':(glob)**/Project.toml' && exit 0
fi
[ -f Manifest.toml ] || exit 0          # nothing resolved yet: instantiate creates it

command -v julia >/dev/null 2>&1 ||
  { log "a Project.toml changed but no julia on PATH; run: julia --project=. -e 'using Pkg; Pkg.update()'"; exit 0; }
TIMEOUT=(); command -v timeout >/dev/null 2>&1 && TIMEOUT=(timeout 900)

log "a Project.toml changed — Pkg.update() at the workspace root (precompile deferred)"
if JULIA_PKG_PRECOMPILE_AUTO=0 "${TIMEOUT[@]}" julia --startup-file=no --project=. \
     -e 'using Pkg; Pkg.update(; io = devnull); println("Manifest legal")' 2>&1 | sed 's/^/[sync-manifest]   /' >&2
then :
else
  log "FAILED — the Manifest may still be illegal; run: julia --startup-file=no --project=. -e 'using Pkg; Pkg.update()'"
fi
exit 0
